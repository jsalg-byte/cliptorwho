NODE_ENV=production
PORT=3001
PUBLIC_BACKEND_URL=https://your-app-domain.com
FRONTEND_URL=https://your-app-domain.com
TRUST_PROXY=true
SESSION_SECRET=replace_with_long_random_value
CONNECTION_ENCRYPTION_KEY=replace_with_long_random_value
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_DOMAIN=
FFMPEG_PATH=/usr/bin/ffmpeg
STORAGE_BACKEND=local
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MAX_STORAGE_GB=0
MAX_STORAGE_BYTES=0
CLIP_RETENTION_DAYS=0
RETENTION_SWEEP_MINUTES=360
ESTIMATED_BYTES_PER_SECOND=750000
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://your-app-domain.com/auth/twitch/callback
KICK_API_KEY=
